# Secrets - never commit
.env
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Experiment output. Raw runs and figures are regenerated by `run --all`.
# Curated results intended for publication should be force-added explicitly.
results/raw/*
results/processed/*
results/figures/*
!results/**/.gitkeep

# Human labels are hand-authored ground truth and ARE version controlled.
!test_cases/labels.jsonl
