# ---------------------------------------------------------------------------
# Evaluator under investigation: TypeSafe Jev
# ---------------------------------------------------------------------------
# Required. Get a key from https://typesafe.ai - the project fails loudly
# without it rather than falling back to a mock.
TYPESAFE_API_KEY=

# Pin an explicit model version for reproducibility. `jev-latest` is the SDK
# default but moves over time, which is bad for a repeatable experiment.
# Run `python -m atlas_jev models` to list available versions.
TYPESAFE_DEFAULT_MODEL=jev-latest

# ---------------------------------------------------------------------------
# Target model under test
# ---------------------------------------------------------------------------
# Backend: ollama | openai_compat | mock
#   ollama        - local Ollama daemon (default)
#   openai_compat - any OpenAI-compatible /v1 endpoint (vLLM, Groq, Together,
#                   OpenRouter, llama.cpp, or Ollama's own /v1 shim)
#   mock          - offline deterministic stub, FOR TESTS ONLY. Never use this
#                   to produce results you intend to report.
TARGET_BACKEND=ollama
TARGET_MODEL=llama3.2:3b

# Ollama
OLLAMA_HOST=http://localhost:11434

# openai_compat only
TARGET_BASE_URL=
TARGET_API_KEY=

# Deterministic decoding. Ground-truth labels are cached against a hash of the
# response text, so non-zero temperature invalidates cached labels on re-runs.
TARGET_TEMPERATURE=0.0
TARGET_MAX_TOKENS=512
